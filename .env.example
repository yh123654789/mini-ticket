# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会进仓库
# cp .env.example .env

# JWT 签名密钥：请换成 32 位以上的随机字符串
JWT_SECRET=please-change-this-to-a-32-byte-random-string

# 前端对外端口（默认 http://localhost:8080）
FRONTEND_PORT=8080

# ---- AI Provider ----
# mock           : 不联网，确定性结果，开箱即用（默认）
# openai         : 走 OpenAI 兼容接口，需要下面三项
AI_PROVIDER=mock

# 任何实现 /chat/completions 的服务都行：
#   OpenAI   https://api.openai.com/v1
#   DeepSeek https://api.deepseek.com/v1
#   本机 Ollama http://host.docker.internal:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10

# 是否在启动时创建演示账号（alice / bob）
SEED_DEMO_USERS=true
